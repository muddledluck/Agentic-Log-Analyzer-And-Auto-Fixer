# Copy to .env and adjust. Never commit .env.

# Avoid 5000 on macOS (often AirPlay). Use 5050 or similar.
PORT=5050
DATABASE_URL="postgresql://postgres:password123@localhost:5432/alaa"
JWT_SECRET="replace-with-at-least-32-random-chars-xxxxxxxx"
REDIS_URL="redis://localhost:6379"
# Must match FastAPI route (router is mounted under /api)
AI_SERVICE_URL="http://localhost:8000/api/analyze"

# Ollama on your Mac/PC (no API key). Pull once: ollama pull llama3
# AI service runs in Docker → reach host Ollama via host.docker.internal
LLM_BASE_URL="http://host.docker.internal:11434"
PARSER_LLM_MODEL="ollama/llama3"
DEBUGGER_LLM_MODEL="ollama/llama3"
# Optional: FALLBACK_LLM_MODEL="ollama/llama3"

# Cloud LLMs (only if you switch models to openai/…, anthropic/…, etc.)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
