# Log Watcher
LOG_FILE_PATH=./system.log
REPORT_DIR=./reports

# Deduplication
DEDUP_TTL_MS=300000
REDIS_URL=redis://localhost:6379

# CrewAI
CREWAI_MODE=http

# LLM Configuration (LiteLLM Format)
PARSER_LLM_MODEL=ollama/llama3
DEBUGGER_LLM_MODEL=openai/gpt-4o
FALLBACK_LLM_MODEL=gemini/gemini-1.5-pro
LLM_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Logging
LOG_LEVEL=info

# Phase 11: Log Sources
ENABLE_DOCKER_SOURCE=false
ENABLE_PM2_SOURCE=false
ENABLE_WEBHOOK_SOURCE=false
WEBHOOK_PORT=9090
WEBHOOK_SECRET_KEY=my-secret-key
DOCKER_CONTAINER_NAMES=
PM2_PROCESS_NAMES=
